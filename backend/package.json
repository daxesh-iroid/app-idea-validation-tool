{
  "name": "app-idea-validation-backend",
  "version": "1.0.0",
  "description": "Backend for App Idea Validation Tool by iRoid Solutions",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "find . -name '*.js' -not -path './node_modules/*' -not -path './coverage/*' -print0 | xargs -0 -n1 node --check",
    "test": "jest --verbose",
    "build": "npm run lint",
    "db:sync": "node scripts/syncDb.js",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "express-validator": "^7.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.0",
    "pdfkit": "^0.14.0",
    "pg": "^8.11.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.0.0"
  }
}
